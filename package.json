{
  "name": "turbofuzz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Clean, reshape and search tabular data entirely in the browser — no uploads, no network",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "playwright test",
    "gate": "npm run typecheck && npm test && npm run test:e2e && npm run build && npm run bench:clean -- --sizes=10000 --iterations=2 && npm run bench:pivot -- --rows=100000 --iterations=2 && npm run bench:multifile -- --rows=10000 && npm run bench:chartspec && npm run bench:outliers && npm run bench:groups-export",
    "bench": "tsx bench/run.ts",
    "bench:quick": "tsx bench/run.ts --sizes=10000 --iterations=10",
    "bench:app": "tsx bench/app-smoke.ts",
    "bench:real": "tsx bench/real.ts",
    "bench:latency": "tsx bench/latency.ts",
    "bench:clean": "tsx bench/clean.ts",
    "bench:pivot": "tsx bench/pivot.ts",
    "bench:multifile": "tsx bench/multifile.ts",
    "bench:chartspec": "tsx bench/chartspec.ts",
    "bench:outliers": "tsx bench/outliers.ts",
    "bench:groups-export": "tsx bench/groups-export.ts",
    "bench:ingest": "tsx bench/ingest.ts",
    "parity:cases": "tsx tools/recipe-parity/make_cases.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@leeoniya/ufuzzy": "^1.0.19",
    "@playwright/test": "^1.64.1",
    "@types/flexsearch": "^0.7.6",
    "@types/node": "^26.6.4",
    "@types/papaparse": "^5.5.2",
    "flexsearch": "^0.7.43",
    "fuse.js": "^7.5.0",
    "happy-dom": "^20.14.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "bz2": "^1.0.1",
    "double-metaphone": "^2.0.1",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "hyparquet": "^1.31.2",
    "hyparquet-compressors": "^1.1.2",
    "mp4-muxer": "^5.2.2",
    "papaparse": "^5.7.0",
    "proj4": "^2.22.0",
    "shpjs": "^6.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
