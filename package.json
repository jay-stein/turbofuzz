{
  "name": "turbofuzz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Clean, reshape and search tabular data entirely in the browser — no uploads, no network",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsx --test test/*.test.ts",
    "bench": "tsx bench/run.ts",
    "bench:quick": "tsx bench/run.ts --sizes=10000 --iterations=10",
    "bench:app": "tsx bench/app-smoke.ts",
    "bench:real": "tsx bench/real.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@leeoniya/ufuzzy": "^1.0.19",
    "@types/flexsearch": "^0.7.6",
    "@types/node": "^26.6.4",
    "@types/papaparse": "^5.5.2",
    "flexsearch": "^0.7.43",
    "fuse.js": "^7.5.0",
    "happy-dom": "^20.14.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "bz2": "^1.0.1",
    "double-metaphone": "^2.0.1",
    "fflate": "^0.8.3",
    "hyparquet": "^1.31.2",
    "hyparquet-compressors": "^1.1.2",
    "papaparse": "^5.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
