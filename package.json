{
  "name": "table-fuzzy-search",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based fuzzy search over tabular data (client-side, no backend)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsx --test test/*.test.ts",
    "bench": "tsx bench/run.ts",
    "bench:quick": "tsx bench/run.ts --sizes=10000 --iterations=10",
    "bench:app": "tsx bench/app-smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@leeoniya/ufuzzy": "^1.0.19",
    "@types/flexsearch": "^0.7.6",
    "@types/node": "^26.6.4",
    "@types/papaparse": "^5.5.2",
    "flexsearch": "^0.7.43",
    "fuse.js": "^7.5.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "double-metaphone": "^2.0.1",
    "papaparse": "^5.7.0"
  }
}
