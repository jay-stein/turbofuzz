# TurboFuzz — Cloudflare Pages headers
#
# Cross-origin isolation is not required today, but it unlocks
# SharedArrayBuffer / threaded WASM later. Every asset here is same-origin.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Vite emits content-hashed asset filenames, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Keep the HTML shell fresh so new deploys are picked up immediately.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
