# TurboFuzz — Cloudflare headers
#
# Security posture: the app parses files entirely in the browser. There is no
# server API and no outbound fetch, so `connect-src 'none'` makes the privacy
# claim enforceable by the browser itself.
#
# Cross-origin isolation is not required today, but it unlocks
# SharedArrayBuffer / threaded WASM later. Every asset here is same-origin.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; worker-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; manifest-src 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Vite emits content-hashed asset filenames, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Keep the HTML shell fresh so new deploys are picked up immediately.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
